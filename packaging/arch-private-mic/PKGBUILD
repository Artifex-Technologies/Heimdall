# Maintainer: Artifex Technologies (https://github.com/Artifex-Technologies)
#
# heimdall-private-mic-git: the private microphone and heimdall-scrub (docs/LOCATION_SOUNDS.md), a package of its own so
# every Labyrinth OS and LykanOS install has it, with or without Heimdall. heimdall-git ships none of these files.
pkgname=heimdall-private-mic-git
pkgver=1.0.0
pkgrel=1
pkgdesc="The private microphone: aircraft tones and mains hum, which can place or date a recording, removed from everything the microphone records; heimdall-scrub for files; and the privacy pack: the downloads guard and Remove hidden info"
arch=('x86_64')
url="https://github.com/Artifex-Technologies/Heimdall"
license=('MPL2' 'MIT')
depends=('glibc' 'gcc-libs' 'pipewire' 'wireplumber')
optdepends=('ffmpeg: heimdall-scrub, scrubbed copies of audio and video files; heimdall-strip, clean copies of videos'
            'libnotify: the downloads guard'"'"'s notices (notify-send)'
            'bubblewrap: the downloads guard lists archives in a sandbox without network'
            'poppler: heimdall-strip checks a cleaned PDF with pdfinfo')
makedepends=('rust' 'git')
provides=('heimdall-private-mic')
conflicts=('heimdall-private-mic')
source=("git+https://github.com/Artifex-Technologies/Heimdall.git")
sha256sums=('SKIP')

# The version is Heimdall's own (VERSION); the build number counts the commits since that release which touch this package's
# files (the crates, packaging/privacy, install.sh, the doc), as Labyrinth_OS's scripts/package-version.sh does.
# --- package version (scripts/package-version.sh) ---
# _version CHECKOUT [PATH...]: sets pkgver and pkgrel. pkgver is the VERSION file at the top of CHECKOUT's git repository (as
# committed); pkgrel, the build number, is 1 + the commits since that file last changed (the release) that touch the PATHs
# in that repository (relative ones are from its top), with the Rust crates they use from it (their path dependencies), or
# the whole repository when no PATH is in it. The recipe's own folder counts too; so does every PATH in another repository
# (by date: its commits since the release). Without a VERSION file (no clone yet: makepkg reads a recipe before it fetches)
# pkgver and pkgrel stay as they are.
_version() {
  local top base since rel=1 a q t todo=() paths=() others=("${startdir:-}")
  top=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null) && base=$(git -C "$top" log -1 --format=%H -- VERSION 2>/dev/null) \
    && [[ -n $base ]] || return 0
  for a in "${@:2}"; do
    [[ $a == /* ]] || a=$top/$a
    a=$(realpath -m "$a")
    if [[ $a == "$top" || $a == "$top"/* ]]; then todo+=("$a"); else others+=("$a"); fi
  done
  while ((${#todo[@]})); do
    a=${todo[0]}; todo=("${todo[@]:1}")
    [[ " ${paths[*]} " == *" $a "* ]] && continue
    paths+=("$a")
    for q in $(sed -n 's/^[^#]*path *= *"\(\.\.[^"]*\)".*/\1/p' "$a/Cargo.toml" 2>/dev/null); do todo+=("$(realpath -m "$a/$q")"); done
  done
  since=$(git -C "$top" log -1 --format=%ct "$base")
  for a in "${others[@]}"; do
    [[ -n $a ]] && t=$(git -C "$a" rev-parse --show-toplevel 2>/dev/null) || continue
    if [[ $t == "$top" ]]; then ((${#paths[@]})) && paths+=("$(realpath "$a")")
    # another checkout of the same repository (an app's own recipe, built from a clone of it): counted above already
    elif [[ $(git -C "$t" rev-list --max-parents=0 HEAD) == "$(git -C "$top" rev-list --max-parents=0 HEAD)" ]]; then continue
    else rel=$((rel + $(git -C "$a" rev-list --count --since="@$since" HEAD -- .))); fi
  done
  pkgver=$(git -C "$top" show HEAD:VERSION)
  pkgrel=$((rel + $(git -C "$top" rev-list --count "$base..HEAD" -- "${paths[@]}")))
}
# _srcdir: makepkg's $srcdir, also while makepkg reads the recipe before setting it (for the clones of -git recipes)
_srcdir() {
  if [[ -n ${srcdir:-} ]]; then echo "$srcdir"
  elif [[ ${BUILDDIR:-} -ef ${startdir:-} ]]; then echo "$BUILDDIR/src"
  else echo "${BUILDDIR:-}/$pkgname/src"; fi
}
# --- end of package version ---

_paths=(rust/scrub rust/scrub-ladspa rust/privacy packaging/privacy-pack docs/PRIVACY_PACK.md rust/Cargo.toml rust/Cargo.lock packaging/privacy packaging/install.sh docs/LOCATION_SOUNDS.md)
_version "$(_srcdir)/Heimdall" "${_paths[@]}"

pkgver() {
	_version "$srcdir/Heimdall" "${_paths[@]}"
	echo "$pkgver"
}

prepare() {
	_version "$srcdir/Heimdall" "${_paths[@]}"
	cd "$srcdir/Heimdall/rust"
	cargo fetch --locked
}

build() {
	cd "$srcdir/Heimdall/rust"
	cargo build --release --locked --offline -p heimdall-scrub -p heimdall-scrub-ladspa -p heimdall-privacy
}

check() {
	cd "$srcdir/Heimdall/rust"
	cargo test --release --locked --offline -p heimdall-scrub -p heimdall-scrub-ladspa -p flyover-attack -p heimdall-privacy
}

package() {
	cd "$srcdir/Heimdall"
	./packaging/install.sh "$pkgdir" private-mic
}
