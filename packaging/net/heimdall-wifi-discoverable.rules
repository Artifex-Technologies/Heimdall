// Settings' "Discoverable" switch on a Wi-Fi network's page: an administrator at the computer may turn it on or off after giving
// their password (kept for a few minutes, as polkit's auth_admin_keep does; the owner's choice, 2026-11-15). Only these two units, only starting them (they stop by themselves), only from an active local session. Turning it
// on lets this computer announce itself on that network; every other protection stays (docs/WIFI_TRUST.md).
polkit.addRule(function(action, subject) {
    var unit = action.lookup("unit") || "";
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        /^heimdall-wifi-discoverable-(on|off)@[0-9a-f-]+\.service$/.test(unit) &&
        action.lookup("verb") == "start" &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.AUTH_ADMIN_KEEP;
    }
});
