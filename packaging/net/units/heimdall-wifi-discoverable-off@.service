[Unit]
Description=Heimdall -- keep this computer from announcing itself on the Wi-Fi network %i (from Settings)
Documentation=file:///usr/share/doc/heimdall/WIFI_TRUST.md

[Service]
# Settings starts this unit (polkit's default for starting units: the administrator's password); the guard takes only a UUID of a
# saved Wi-Fi profile
Type=oneshot
ExecStart=/usr/bin/heimdall-wifi-guard discoverable off --uuid %i
