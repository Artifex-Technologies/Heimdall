#!/bin/bash
# heimdall-intel-update: fetch the files Heimdall checks against, all used offline on this computer:
#   - the IP databases that say where an address belongs (country and network), monthly
#   - threat lists of known malware, botnet and criminal addresses (Spamhaus DROP, FireHOL Level 1, Emerging Threats), daily
#   - Arch Linux's security tracker (which package versions have known vulnerabilities), daily
#   - the Linux kernel's CVE records (osv.dev) with CISA's known-exploited list, weekly
#   - URLhaus's ClamAV signatures (addresses known to spread malware), daily, when an abuse.ch Auth-Key is there; root's step
#     `heimdall-intel-update install-clamav` (the unit's ExecStartPost) puts the checked copy into ClamAV's database folder
#
# Only these files are downloaded; no address Heimdall has seen and nothing about this computer is ever sent anywhere. heimdalld itself never connects off the
# machine (its own rule), so this separate script does the download, and `heimdalld ipdb-check` validates each file before it
# replaces the one in use (a broken or tampered download is thrown away and the old file stays).
#
# Sources, both free:
#   - IPinfo Lite (country + network in one file), when a token is in /etc/heimdall/ipinfo-token (a free account at ipinfo.io).
#     Data: IPinfo, CC BY-SA 4.0.
#   - otherwise DB-IP Lite (country file + network file, no account). Data: DB-IP.com, CC BY 4.0.
# Threat lists: Spamhaus DROP/DROPv6 (free to use), FireHOL Level 1 (iplists.firehol.org, aggregated from public sources), Emerging
# Threats compromised hosts (Proofpoint, free). Security tracker: security.archlinux.org. URLhaus (abuse.ch): free for
# not-for-profit use with an Auth-Key from auth.abuse.ch in /etc/heimdall/abusech-auth-key, switched off with
# "urlhaus_clamav": false in /etc/heimdall/config.json (docs/IMMUNITY.md, "URLhaus"). Run daily by heimdall-intel-update.timer,
# as the heimdall user. A source that fails keeps its last good file.
set -euo pipefail
umask 027

intel=${HEIMDALL_INTEL_DIR:-/var/lib/heimdall/intel}

# ---- URLhaus's ClamAV signatures: shared by the download (heimdall) and the install into ClamAV's folder (root)
urlhaus_min=${HEIMDALL_URLHAUS_MIN:-500} # fewer signatures than this is an error page or a broken export, not the list

urlhaus_on() { # the switch "urlhaus_clamav" in heimdalld's config: on unless it is exactly false
  local conf=${HEIMDALL_CONFIG:-/etc/heimdall/config.json} rc=0
  [[ -r $conf ]] || return 0
  python3 -I -c 'import json, sys
try:
    v = json.load(open(sys.argv[1])).get("urlhaus_clamav", True)
except Exception:
    v = True
sys.exit(1 if v is False else 0)' "$conf" || rc=$?
  [[ $rc != 1 ]]
}

ndb_lines() { # stdin -> only the lines that are plain ClamAV body signatures (name:target:offset:hex[:flevel[:flevel]]) of at
  # least 8 literal bytes; anything else (comments, HTML, other signature kinds, a pattern so short it would match everywhere)
  # is dropped, so a hostile or broken download cannot add anything but address patterns
  tr -d '\r' | LC_ALL=C awk -F: 'NF >= 4 && NF <= 6 && length($0) <= 8192 &&
    $1 ~ /^[A-Za-z0-9_.-]+$/ && length($1) <= 128 && $2 ~ /^[0-9]+$/ && $2 + 0 <= 14 &&
    $3 ~ /^(\*|[0-9]+|EOF-[0-9]+|EP[+-][0-9]+)(,[0-9]+)?$/ && $4 ~ /^[][0-9A-Fa-f?*{}()|!,-]+$/ &&
    (NF < 5 || $5 ~ /^[0-9]+$/) && (NF < 6 || $6 ~ /^[0-9]+$/) {
      h = $4; if (gsub(/[0-9A-Fa-f]/, "", h) >= 16) print }'
}

install_clamav() { # root (the unit's ExecStartPost): the last good copy into ClamAV's folder, owned like ClamAV's own files
  local db=${HEIMDALL_CLAMAV_DIR:-/var/lib/clamav} src=$intel/urlhaus.ndb
  local dst=$db/heimdall-urlhaus.ndb n
  [[ -d $db ]] || return 0 # no ClamAV: nothing to do
  if ! urlhaus_on; then
    rm -f "$dst" # switched off: ClamAV stops using it
    return 0
  fi
  work=$(mktemp -d)
  trap 'rm -rf "$work"' EXIT
  # a snapshot that is never a link (heimdall's folder is not root's), read again through the filter: only signature lines pass
  cp -P -- "$src" "$work/src" 2>/dev/null || return 0
  [[ -f $work/src && ! -L $work/src ]] || { echo "heimdall-intel-update: $src is not a plain file; not installed" >&2; return 1; }
  ndb_lines <"$work/src" >"$work/ndb"
  n=$(wc -l <"$work/ndb")
  if (( n < urlhaus_min )); then
    echo "heimdall-intel-update: $src holds $n signatures; ClamAV's copy stays" >&2
    return 1
  fi
  if [[ -f $dst ]] && cmp -s "$work/ndb" "$dst"; then
    return 0
  fi
  local tmp; tmp=$(mktemp "$db/.heimdall-urlhaus.XXXXXX")
  if cp -- "$work/ndb" "$tmp" && chown --reference="$db" -- "$tmp" && chmod 0644 -- "$tmp" && mv -f -- "$tmp" "$dst"; then
    echo "heimdall-intel-update: ClamAV now knows $n URLhaus signatures ($dst)"
  else
    rm -f -- "$tmp"
    return 1
  fi
}

if [[ ${1:-} == install-clamav ]]; then
  install_clamav
  exit
fi

dir=${HEIMDALL_IPDB_DIR:-/var/lib/heimdall/ipdb}
mkdir -p "$intel"
mkdir -p "$dir"
tmp=$(mktemp -d "$dir/.update.XXXXXX")
trap 'rm -rf "$tmp"' EXIT

fetch() { # url out.gz-or-file
  curl -fsSL --proto '=https' --tlsv1.2 --max-time 300 --max-filesize 200000000 -o "$2" "$1"
}

install_checked() { # downloaded-file final-name
  if heimdalld ipdb-check "$1"; then
    mv -f "$1" "$dir/$2"
  else
    echo "heimdall-intel-update: $2 failed the check; the old file stays" >&2
    return 1
  fi
}

# ---- threat lists and the security tracker (daily)
itmp=$(mktemp -d "$intel/.update.XXXXXX")
trap 'rm -rf "$tmp" "$itmp"' EXIT
intel_ok=0
get_intel() { # url kind name
  # a list is also compared with its last good copy (a sudden wide range or a list emptied is refused)
  local prev=(); [[ $2 == list && -f $intel/$3 ]] && prev=("$intel/$3")
  if fetch "$1" "$itmp/$3" && heimdalld intel-check "$2" "$itmp/$3" "${prev[@]}"; then
    mv -f "$itmp/$3" "$intel/$3"
    intel_ok=1
  else
    echo "heimdall-intel-update: $3 not updated; the last good copy stays" >&2
  fi
}
get_intel "https://www.spamhaus.org/drop/drop_v4.json" list spamhaus-drop.list
get_intel "https://www.spamhaus.org/drop/drop_v6.json" list spamhaus-dropv6.list
get_intel "https://iplists.firehol.org/files/firehol_level1.netset" list firehol-level1.list
get_intel "https://rules.emergingthreats.net/blockrules/compromised-ips.txt" list et-compromised.list
get_intel "https://security.archlinux.org/issues/all.json" tracker arch-security.json

# ---- URLhaus's ClamAV signatures (daily): addresses known to spread malware, so a downloaded document or script that carries one
# is flagged by the scans that already run. Only the whole export is downloaded; no address or file of this computer is ever
# asked about. abuse.ch serves it only with a (free) Auth-Key, which goes in the address's path; curl reads the address from
# its standard input, so the key is not in the process list, and its messages never print the address.
get_urlhaus() {
  urlhaus_on || return 0
  local keyf=${HEIMDALL_ABUSECH_KEY_FILE:-/etc/heimdall/abusech-auth-key} key=""
  [[ -r $keyf ]] && key=$(tr -dc 'A-Za-z0-9' <"$keyf")
  if [[ -z $key ]]; then
    echo "heimdall-intel-update: URLhaus's ClamAV signatures need a free abuse.ch Auth-Key in $keyf; skipped" >&2
    return 0
  fi
  local raw=$itmp/urlhaus.raw ndb=$itmp/urlhaus.ndb last=0 n all
  if ! printf 'url = "https://urlhaus-api.abuse.ch/v2/files/exports/%s/urlhaus_clamav.ndb"\n' "$key" |
      curl -fsSL --proto '=https' --tlsv1.2 --max-time 300 --max-filesize 50000000 -K - -o "$raw"; then
    echo "heimdall-intel-update: URLhaus's ClamAV signatures not fetched; the last good copy stays" >&2
    return 0
  fi
  ndb_lines <"$raw" >"$ndb"
  n=$(wc -l <"$ndb")
  all=$(tr -d '\r' <"$raw" | grep -cvE '^[[:space:]]*(#|$)' || true)
  [[ -f $intel/urlhaus.ndb ]] && last=$(wc -l <"$intel/urlhaus.ndb")
  local why=""
  if (( n < urlhaus_min )); then
    why="only $n signatures"
  elif (( n * 10 < all * 9 )); then
    why="$((all - n)) of $all lines are not plain signatures (the format changed?)"
  elif (( n * 4 < last )); then
    why="$n signatures where the last copy had $last"
  elif command -v "${HEIMDALL_CLAMSCAN:-clamscan}" >/dev/null; then
    # ClamAV's own load test: only this file as the database, scanning an empty file (exit 0: loaded, nothing found)
    : >"$itmp/empty"
    "${HEIMDALL_CLAMSCAN:-clamscan}" --no-summary --quiet -d "$ndb" "$itmp/empty" >/dev/null 2>&1 || why="ClamAV could not load it"
  fi
  if [[ -n $why ]]; then
    echo "heimdall-intel-update: URLhaus's ClamAV signatures refused ($why); the last good copy stays" >&2
    return 0
  fi
  mv -f "$ndb" "$intel/urlhaus.ndb"
  rm -f "$raw"
  echo "heimdall-intel-update: URLhaus: $n ClamAV signatures"
  intel_ok=1
}
get_urlhaus

# ---- the kernel's own CVE records (weekly: about 60 MB) and CISA's list of vulnerabilities exploited in the wild, made into
# one small file (linux-kernel.json) that heimdalld matches against the installed kernels
if [[ -z $(find "$intel" -maxdepth 1 -name linux-kernel.json -mtime -6 2>/dev/null) || ${HEIMDALL_KERNEL_FORCE:-0} == 1 ]]; then
  kev=""
  if fetch "https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json" "$itmp/kev.json"; then
    kev="$itmp/kev.json"
  fi
  if fetch "https://osv-vulnerabilities.storage.googleapis.com/Linux/all.zip" "$itmp/linux.zip" &&
      heimdalld intel-check kernel "$itmp/linux.zip" "$intel/linux-kernel.json" $kev; then
    intel_ok=1
  else
    echo "heimdall-intel-update: the kernel CVE list not updated; the last good copy stays" >&2
  fi
  rm -f "$itmp/linux.zip" "$itmp/kev.json"
fi

# ---- IP databases (monthly is enough: they change slowly)
fresh() { [[ -n $(find "$dir" -maxdepth 1 -name '*.mmdb' -mtime -25 2>/dev/null | head -n1) ]]; }
if fresh && [[ ${HEIMDALL_IPDB_FORCE:-0} != 1 ]]; then
  [[ $intel_ok == 1 ]] || { echo "heimdall-intel-update: nothing could be fetched" >&2; exit 1; }
  exit 0
fi
ok=0
token_file=${HEIMDALL_IPINFO_TOKEN_FILE:-/etc/heimdall/ipinfo-token}
if [[ -r $token_file ]] && token=$(tr -dc 'A-Za-z0-9' <"$token_file") && [[ -n $token ]]; then
  # the token goes in a header, not the URL, so it does not end up in a log line
  if curl -fsSL --proto '=https' --tlsv1.2 --max-time 300 --max-filesize 200000000 -H "Authorization: Bearer $token" \
      -o "$tmp/ipinfo_lite.mmdb" "https://ipinfo.io/data/ipinfo_lite.mmdb" && install_checked "$tmp/ipinfo_lite.mmdb" ipinfo_lite.mmdb; then
    ok=1
  else
    echo "heimdall-intel-update: IPinfo Lite download failed; trying DB-IP Lite" >&2
  fi
fi
if [[ $ok == 0 ]]; then
  for kind in country asn; do
    got=0
    # this month's file appears on the 1st; early in the month last month's is still the newest
    for month in "$(date -u +%Y-%m)" "$(date -u -d "$(date -u +%Y-%m-01) -1 day" +%Y-%m)"; do
      if fetch "https://download.db-ip.com/free/dbip-$kind-lite-$month.mmdb.gz" "$tmp/$kind.mmdb.gz"; then
        gzip -dc "$tmp/$kind.mmdb.gz" >"$tmp/dbip-$kind-lite.mmdb" && got=1 && break
      fi
    done
    [[ $got == 1 ]] && install_checked "$tmp/dbip-$kind-lite.mmdb" "dbip-$kind-lite.mmdb" && ok=1
  done
fi
[[ $ok == 1 || $intel_ok == 1 ]] || { echo "heimdall-intel-update: nothing could be fetched" >&2; exit 1; }
