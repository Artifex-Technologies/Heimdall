# Maintainer: Artifex Technologies (https://github.com/Artifex-Technologies)
pkgname=heimdall-git
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc="Heimdall -- security agent monitoring Sarina for prompt injection, credential leaks, and permission escalation"
arch=('x86_64')
url="https://github.com/Artifex-Technologies/Heimdall"
license=('MPL2')
depends=('glibc' 'curl' 'gzip' 'python' 'iproute2' 'iw' 'networkmanager' 'dnsmasq' 'nftables')
# rust: the Wi-Fi helpers (heimdall-wifi-check, -guard, -notify) are the Rust heimdalld under their names; python stays for
# their Python programs, kept as the fallback (docs/RUST_SWITCH.md)
makedepends=('go' 'git' 'rust')
provides=('heimdall')
conflicts=('heimdall')
backup=('etc/heimdall/dns-allow.txt' 'etc/NetworkManager/dnsmasq.d/heimdall-blocklist.conf')
source=("git+https://github.com/Artifex-Technologies/Heimdall.git")
sha256sums=('SKIP')

pkgver() {
	cd "$srcdir/Heimdall"
	printf "0.1.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
	cd "$srcdir/Heimdall"
	export CGO_ENABLED=0
	go build -trimpath -ldflags "-s -w" -o heimdalld ./cmd/heimdalld
	# offline first, so a build with the crates already fetched never reaches the network
	(cd rust && { cargo build --release --locked --offline || cargo build --release --locked; })
}

check() {
	cd "$srcdir/Heimdall"
	go test ./...
}

package() {
	cd "$srcdir/Heimdall"
	./packaging/install.sh "$pkgdir"
}
