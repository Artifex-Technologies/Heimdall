[Unit]
Description=Heimdall -- check whether the Wi-Fi network just joined is safe
Documentation=https://github.com/Artifex-Technologies/Heimdall
After=NetworkManager.service

[Service]
Type=oneshot
User=heimdall
Group=heimdall
ExecStart=/usr/bin/heimdall-wifi-check --uuid %i
StateDirectory=heimdall heimdall/wifi
RuntimeDirectory=heimdall-wifi
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
TimeoutStartSec=3min
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/heimdall
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=
SystemCallFilter=@system-service
