[Unit]
Description=Heimdall -- the devices on a trusted home network (maker, name, first and last seen)
Documentation=https://github.com/Artifex-Technologies/Heimdall/blob/main/docs/DEVICES.md
After=NetworkManager.service

[Service]
Type=oneshot
User=heimdall
Group=heimdall
# does nothing on a network the owner has not trusted (heimdall-wifi-guard trust), or when its router is not the one trusted
ExecStart=/usr/bin/heimdalld lan scan
StateDirectory=heimdall heimdall/lan
StateDirectoryMode=0750
TimeoutStartSec=1min
# keeps running during games (an intruder does not wait for one to end), with a small share when the computer is busy
Nice=10
CPUWeight=20
IOWeight=20
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/heimdall
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictNamespaces=yes
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
UMask=0027
