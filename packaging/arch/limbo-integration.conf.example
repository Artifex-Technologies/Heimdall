# Optional systemd drop-in: let Heimdall use Limbo (quarantine response + audit log).
#
#   sudo install -Dm644 limbo-integration.conf.example \
#        /etc/systemd/system/heimdall.service.d/limbo.conf
#   sudo systemctl daemon-reload && sudo systemctl restart heimdall
#
# Membership of the limbo-heimdall group (created by Limbo's sysusers file, so
# Limbo must be installed first) is the whole access control:
#   - control.sock: Heimdall may restrict a guest and attach advisories. That
#     socket has no route to release a guest or give a verdict, so this grants
#     no way to loosen anything.
#   - the audit log (events.jsonl): group-readable, so Heimdall can read it and
#     cannot write it.
# Pair it with, in config.json:
#   "limbo_event_log":      "/var/lib/limbo/state/events.jsonl",
#   "limbo_control_socket": "/run/limbo/control.sock",
#   "limbo_state_path":     "/var/lib/heimdall/limbo-offset"
[Service]
SupplementaryGroups=limbo-heimdall
# ProtectSystem=strict (in the main unit) makes the file system read-only for
# this service; connecting to a unix socket and reading a log still work.
ReadOnlyPaths=/var/lib/limbo/state
