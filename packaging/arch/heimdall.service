[Unit]
Description=Heimdall -- Sarina agent-behavior monitor
Documentation=https://github.com/Artifex-Technologies/Heimdall
After=network.target

[Service]
Type=simple
User=heimdall
Group=heimdall
ExecStart=/usr/bin/heimdalld run --config /etc/heimdall/config.json
Restart=on-failure
RestartSec=5

# Games and the local AI model come first. These only matter when the processor or disk is busy: then heimdalld gets a
# smaller share (CPUWeight and IOWeight against the other system services, the model's among them; Nice for its own
# processes and their disk priority), and its detections arrive a little later. Nothing is paused. Its long audits also
# wait while a game runs (internal/gametime).
CPUWeight=20
IOWeight=20
Nice=10

StateDirectory=heimdall
StateDirectoryMode=0750

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/var/lib/heimdall
# requests for root (heimdall-requests.service): a copy of each file Limbo held as malware (owner's yes, 2026-11-05)
ReadWritePaths=-/var/lib/heimdall-requests

# The connection drop-in (heimdall-connwatch.conf.example) gives Heimdall read access over other users' processes and files.
# These keep a bug in the daemon from turning that into control (2026-10-27 audit): no ptrace or cross-process memory calls,
# /proc read-only (so no writes to another process's memory), no device opens, no new namespaces, kernel settings, modules,
# log and clock untouchable. Checked live: the connection log still names other users' programs.
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~ptrace process_vm_readv process_vm_writev kcmp pidfd_getfd
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
DevicePolicy=closed
ReadOnlyPaths=/proc
UMask=0077

[Install]
WantedBy=multi-user.target
